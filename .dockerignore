# ============================================
# Docker Ignore File
# Exclude unnecessary files from Docker build
# ============================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next
out

# Testing
coverage
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment files (except templates)
.env
.env.local
.env.development
.env.production
!.env.docker
!.env.example

# Git
.git
.gitignore

# Documentation (optional - remove if you want docs in image)
*.md
!README.md

# Docker files
Dockerfile*
docker-compose*
.dockerignore

# Build artifacts
dist
build

# Logs
logs
*.log

# Debug
npm-debug.log*

# Misc
.eslintcache
.npm
.yarn-integrity

# Test files
__tests__
*.test.*
*.spec.*

# Development scripts
scripts/
check*.sql
migrate*.sql
seed.js

# Temporary files
tmp/
temp/
