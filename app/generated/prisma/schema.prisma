generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
  // url = env("DATABASE_URL")
}

model UserSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  // Notification settings
  emailNotifications  Boolean  @default(true)
  smsNotifications    Boolean  @default(false)
  pushNotifications   Boolean  @default(true)
  applicationUpdates  Boolean  @default(true)
  systemAlerts        Boolean  @default(true)
  marketingEmails     Boolean  @default(false)
  // Privacy settings
  profileVisibility   String   @default("department_only") // public, private, department_only
  showContactInfo     Boolean  @default(false)
  allowDirectMessages Boolean  @default(true)
  // System preferences
  theme               String   @default("system") // light, dark, system
  language            String   @default("en") // en, hi, ne
  timezone            String   @default("Asia/Kolkata")
  dateFormat          String   @default("DD/MM/YYYY") // DD/MM/YYYY, MM/DD/YYYY, YYYY-MM-DD
  itemsPerPage        Int      @default(20)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model User {
  id                     String                     @id @default(uuid())
  email                  String                     @unique
  phone                  String?                    @unique
  passwordHash           String?
  role                   UserRole                   @default(FRONT_DESK)
  isActive               Boolean                    @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  level                  Int?
  auditLogs              ApplicationAuditLog[]      @relation("PerformedBy")
  validations            ApplicationValidation[]    @relation("ValidatedBy")
  workflowChanges        ApplicationWorkflow[]      @relation("ChangedBy")
  currentHolderFiles     Application[]              @relation("CurrentHolder")
  dispatchedApplications Application[]              @relation("DispatchedBy")
  citizenProfile         CitizenProfile?
  documentRequests       DocumentRequest[]          @relation("RequestedBy")
  uploadedDocuments      Document[]                 @relation("UploadedBy")
  verifiedDocuments      Document[]                 @relation("VerifiedBy")
  forwardedFrom          FrontdeskForwarding[]      @relation("ForwardedFrom")
  forwardedTo            FrontdeskForwarding[]      @relation("ForwardedTo")
  frontdeskAssignments   FrontdeskOfficer[]         @relation("FrontdeskAssignments")
  notifications          Notification[]
  assignmentsGiven       OfficerAssignment[]        @relation("AssignedBy")
  assignmentsReceived    OfficerAssignment[]        @relation("AssignedTo")
  officerForwardedFrom   OfficerForwardingHistory[] @relation("OfficerForwardedFrom")
  officerForwardedTo     OfficerForwardingHistory[] @relation("OfficerForwardedTo")
  officerProfile         OfficerProfile?
  serviceCategoryChanges ServiceCategoryChange[]    @relation("CategoryChangedBy")
  userSettings           UserSettings?

  @@map("users")
}

model CitizenProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  fullName      String
  phone         String
  address       String
  aadhaarNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("citizen_profiles")
}

model OfficerProfile {
  id             String             @id @default(uuid())
  userId         String             @unique
  fullName       String
  designation    String
  department     String
  officeLocation String?
  isAvailable    Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  sectionId      String?
  frontdeskUsers FrontdeskOfficer[]
  section        Section?           @relation(fields: [sectionId], references: [id])
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("officer_profiles")
}

model FrontdeskOfficer {
  id              String          @id @default(uuid())
  frontdeskUserId String
  officerId       String?
  createdAt       DateTime        @default(now())
  frontdeskUser   User            @relation("FrontdeskAssignments", fields: [frontdeskUserId], references: [id], onDelete: Cascade)
  officer         OfficerProfile? @relation(fields: [officerId], references: [id], onDelete: Cascade)

  @@unique([frontdeskUserId, officerId])
  @@map("frontdesk_officers")
}

model ServiceCategory {
  id                      String                  @id @default(uuid())
  name                    String                  @unique
  description             String?
  isActive                Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  color                   String?
  applications            Application[]
  newCategoryChanges      ServiceCategoryChange[] @relation("NewCategory")
  previousCategoryChanges ServiceCategoryChange[] @relation("PreviousCategory")

  @@map("service_categories")
}

model Section {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  officers    OfficerProfile[]

  @@map("sections")
}

model Department {
  id           String        @id @default(uuid())
  name         String        @unique
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]

  @@map("departments")
}

model Application {
  id                     String                     @id @default(uuid())
  rrNumber               String?                    @unique
  serviceCategoryId      String
  status                 ApplicationStatus          @default(DRAFT)
  currentHolderId        String?
  submittedAt            DateTime?
  validatedAt            DateTime?
  completedAt            DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  citizenAddress         String
  citizenEmail           String?
  citizenGender          String?
  citizenName            String
  citizenPhone           String
  citizenAlternateNumber String?
  subject                String                     @default("Application Subject")
  departmentId           String?
  dispatchedAt           DateTime?
  dispatchedById         String?
  isDispatched           Boolean                    @default(false)
  applicationSource      ApplicationSource          @default(PUBLIC)
  auditLogs              ApplicationAuditLog[]
  validation             ApplicationValidation?
  workflow               ApplicationWorkflow[]
  currentHolder          User?                      @relation("CurrentHolder", fields: [currentHolderId], references: [id])
  department             Department?                @relation(fields: [departmentId], references: [id])
  dispatchedBy           User?                      @relation("DispatchedBy", fields: [dispatchedById], references: [id])
  serviceCategory        ServiceCategory            @relation(fields: [serviceCategoryId], references: [id])
  documentRequests       DocumentRequest[]
  documents              Document[]
  frontdeskForwardings   FrontdeskForwarding[]
  notifications          Notification[]
  officerAssignments     OfficerAssignment[]
  officerForwardings     OfficerForwardingHistory[]
  serviceCategoryChanges ServiceCategoryChange[]

  @@map("applications")
}

model ApplicationWorkflow {
  id            String             @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String
  comments      String?
  createdAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id])
  changedBy     User               @relation("ChangedBy", fields: [changedById], references: [id])

  @@map("application_workflow")
}

model ApplicationValidation {
  id                    String      @id @default(uuid())
  applicationId         String      @unique
  validatedById         String
  rrNumber              String
  isDocumentsComplete   Boolean     @default(false)
  isEligibilityVerified Boolean     @default(false)
  validationNotes       String?
  createdAt             DateTime    @default(now())
  application           Application @relation(fields: [applicationId], references: [id])
  validatedBy           User        @relation("ValidatedBy", fields: [validatedById], references: [id])

  @@map("application_validations")
}

model ServiceCategoryChange {
  id                 String           @id @default(uuid())
  applicationId      String
  previousCategoryId String?
  newCategoryId      String
  changedById        String
  reason             String?
  createdAt          DateTime         @default(now())
  application        Application      @relation(fields: [applicationId], references: [id])
  changedBy          User             @relation("CategoryChangedBy", fields: [changedById], references: [id])
  newCategory        ServiceCategory  @relation("NewCategory", fields: [newCategoryId], references: [id])
  previousCategory   ServiceCategory? @relation("PreviousCategory", fields: [previousCategoryId], references: [id])

  @@map("service_category_changes")
}

model OfficerAssignment {
  id                     String      @id @default(uuid())
  applicationId          String
  assignedById           String
  assignedToId           String
  expectedCompletionDate DateTime?
  priority               Int         @default(1) // Always HIGH priority
  instructions           String?
  createdAt              DateTime    @default(now())
  application            Application @relation(fields: [applicationId], references: [id])
  assignedBy             User        @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedTo             User        @relation("AssignedTo", fields: [assignedToId], references: [id])

  @@map("officer_assignments")
}

model Document {
  id                String       @id @default(uuid())
  applicationId     String
  documentType      DocumentType
  fileName          String
  filePath          String
  fileSize          Int
  uploadedById      String
  isVerified        Boolean      @default(false)
  verifiedById      String?
  verificationNotes String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  application       Application  @relation(fields: [applicationId], references: [id])
  uploadedBy        User         @relation("UploadedBy", fields: [uploadedById], references: [id])
  verifiedBy        User?        @relation("VerifiedBy", fields: [verifiedById], references: [id])

  @@map("documents")
}

model DocumentRequest {
  id            String       @id @default(uuid())
  applicationId String
  requestedById String
  documentType  DocumentType
  reason        String?
  dueDate       DateTime?
  isCompleted   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  application   Application  @relation(fields: [applicationId], references: [id])
  requestedBy   User         @relation("RequestedBy", fields: [requestedById], references: [id])

  @@map("document_requests")
}

model Notification {
  id               String           @id @default(uuid())
  userId           String
  notificationType NotificationType
  applicationId    String?
  title            String
  message          String
  isRead           Boolean          @default(false)
  readAt           DateTime?
  createdAt        DateTime         @default(now())
  application      Application?     @relation(fields: [applicationId], references: [id])
  user             User             @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model ApplicationAuditLog {
  id            String      @id @default(uuid())
  applicationId String
  action        String
  performedById String
  oldValues     Json?
  newValues     Json?
  ipAddress     String?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id])
  performedBy   User        @relation("PerformedBy", fields: [performedById], references: [id])

  @@map("application_audit_logs")
}

model DailyReport {
  id                String   @id @default(uuid())
  reportDate        DateTime @db.Date
  totalApplications Int      @default(0)
  pendingValidation Int      @default(0)
  inProgress        Int      @default(0)
  completed         Int      @default(0)
  avgProcessingTime Int?
  createdAt         DateTime @default(now())

  @@map("daily_reports")
}

model SystemSetting {
  id           String   @id @default(uuid())
  settingKey   String   @unique
  settingValue String
  description  String?
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("system_settings")
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  token      String   @unique
  expires    DateTime
  type       String
  metadata   String? // JSON string for storing additional secure data

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SmsOtp {
  id               String   @id @default(uuid())
  phone            String
  otp              String
  status           String // SENT, FAILED, USED
  providerResponse String? // JSON string for storing provider response
  type             String   @default("VERIFICATION") // VERIFICATION, LOGIN, PASSWORD_RESET
  attempts         Int      @default(0)
  isUsed           Boolean  @default(false)
  expires          DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("sms_otps")
}

model ApplicationTrackingOTP {
  id         String   @id @default(uuid())
  identifier String
  otp        String
  otpType    String
  sentTo     String
  isUsed     Boolean  @default(false)
  attempts   Int      @default(0)
  expires    DateTime
  createdAt  DateTime @default(now())

  @@map("application_tracking_otps")
}

model FrontdeskForwarding {
  id              String      @id @default(uuid())
  applicationId   String
  fromFrontdeskId String
  toFrontdeskId   String
  fromOfficerId   String
  toOfficerId     String
  instructions    String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  application     Application @relation(fields: [applicationId], references: [id])
  fromFrontdesk   User        @relation("ForwardedFrom", fields: [fromFrontdeskId], references: [id])
  toFrontdesk     User        @relation("ForwardedTo", fields: [toFrontdeskId], references: [id])

  @@map("frontdesk_forwardings")
}

model OfficerForwardingHistory {
  id            String      @id @default(uuid())
  applicationId String
  fromOfficerId String
  toOfficerId   String
  instructions  String?
  priority      Int         @default(1) // Always HIGH priority
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  completedAt   DateTime?
  forwardedAt   DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id])
  fromOfficer   User        @relation("OfficerForwardedFrom", fields: [fromOfficerId], references: [id])
  toOfficer     User        @relation("OfficerForwardedTo", fields: [toOfficerId], references: [id])

  @@map("officer_forwarding_history")
}

enum UserRole {
  FRONT_DESK
  DC
  ADC
  RO
  SDM
  DYDIR
  ADMIN
  SUPER_ADMIN
  ADC_GTK
  ADC_HQ
  SDM_GTK
  SDM_HQ
  AC
  DPO_DDMA
  DD_REV
  DD_ACQ
  US_ADM
  AO
  TO_DDMA
  AD_IT
  US_ELECTION
  OS_COI_RC
  OS_RC
  RI_LEGAL
  DISPATCH_HANDLER
}

enum ApplicationStatus {
  DRAFT
  PENDING
  VALIDATED
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum DocumentType {
  ID_PROOF
  ADDRESS_PROOF
  APPLICATION_FORM
  SUPPORTING_DOCUMENT
  PAYMENT_RECEIPT
}

enum NotificationType {
  APPLICATION_SUBMITTED
  STATUS_CHANGED
  DOCUMENT_REQUESTED
  PAYMENT_REQUIRED
}

enum ApplicationSource {
  PUBLIC
  GOVERNMENT
}
