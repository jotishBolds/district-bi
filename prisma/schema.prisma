generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
  url = env("DIRECT_URL") 
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  // Notification settings
  emailNotifications   Boolean  @default(true)
  smsNotifications     Boolean  @default(false)
  pushNotifications    Boolean  @default(true)
  applicationUpdates   Boolean  @default(true)
  systemAlerts         Boolean  @default(true)
  marketingEmails      Boolean  @default(false)
  // Privacy settings
  profileVisibility    String   @default("department_only") // public, private, department_only
  showContactInfo      Boolean  @default(false)
  allowDirectMessages  Boolean  @default(true)
  // System preferences
  theme                String   @default("system") // light, dark, system
  language             String   @default("en") // en, hi, ne
  timezone             String   @default("Asia/Kolkata")
  dateFormat           String   @default("DD/MM/YYYY") // DD/MM/YYYY, MM/DD/YYYY, YYYY-MM-DD
  itemsPerPage         Int      @default(20)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model User {
  id                     String                     @id @default(uuid())
  email                  String                     @unique
  phone                  String?                    @unique
  passwordHash           String?
  role                   UserRole                   @default(FRONT_DESK)
  isActive               Boolean                    @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  level                  Int?
  auditLogs              ApplicationAuditLog[]      @relation("PerformedBy")
  validations            ApplicationValidation[]    @relation("ValidatedBy")
  workflowChanges        ApplicationWorkflow[]      @relation("ChangedBy")
  currentHolderFiles     Application[]              @relation("CurrentHolder")
  dispatchedApplications Application[]              @relation("DispatchedBy")
  citizenProfile         CitizenProfile?
  documentRequests       DocumentRequest[]          @relation("RequestedBy")
  uploadedDocuments      Document[]                 @relation("UploadedBy")
  verifiedDocuments      Document[]                 @relation("VerifiedBy")
  forwardedFrom          FrontdeskForwarding[]      @relation("ForwardedFrom")
  forwardedTo            FrontdeskForwarding[]      @relation("ForwardedTo")
  frontdeskAssignments   FrontdeskOfficer[]         @relation("FrontdeskAssignments")
  notifications          Notification[]
  assignmentsGiven       OfficerAssignment[]        @relation("AssignedBy")
  assignmentsReceived    OfficerAssignment[]        @relation("AssignedTo")
  officerForwardedFrom   OfficerForwardingHistory[] @relation("OfficerForwardedFrom")
  officerForwardedTo     OfficerForwardingHistory[] @relation("OfficerForwardedTo")
  officerProfile         OfficerProfile?
  serviceCategoryChanges ServiceCategoryChange[]    @relation("CategoryChangedBy")
  userSettings           UserSettings?
  
  // SAMADHAN Module Relations
  samadhanTicketsAsCitizen    SamadhanTicket[]         @relation("SamadhanCitizenTickets")
  samadhanTicketsAsOfficer    SamadhanTicket[]         @relation("SamadhanAssignedOfficer")
  samadhanTicketsEscalated    SamadhanTicket[]         @relation("SamadhanEscalatedTo")
  samadhanTicketsAssigned     SamadhanTicket[]         @relation("SamadhanAssignedBy")
  samadhanAttachmentsUploaded SamadhanAttachment[]     @relation("SamadhanAttachmentUploader")
  samadhanInfoRequests        SamadhanInfoRequest[]    @relation("SamadhanInfoRequestedBy")
  samadhanStatusChanges       SamadhanStatusHistory[]  @relation("SamadhanStatusChangedBy")
  samadhanInternalNotes       SamadhanInternalNote[]   @relation("SamadhanNoteCreator")

  @@map("users")
}

model CitizenProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  fullName          String
  phone             String
  address           String
  aadhaarNumber     String?
  samadhanPseudonym String?  // Random pseudonym for SAMADHAN module
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("citizen_profiles")
}

model OfficerProfile {
  id             String             @id @default(uuid())
  userId         String             @unique
  fullName       String
  designation    String
  department     String
  officeLocation String?
  isAvailable    Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  sectionId      String?
  frontdeskUsers FrontdeskOfficer[]
  section        Section?           @relation(fields: [sectionId], references: [id])
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("officer_profiles")
}

model FrontdeskOfficer {
  id              String          @id @default(uuid())
  frontdeskUserId String
  officerId       String?
  createdAt       DateTime        @default(now())
  frontdeskUser   User            @relation("FrontdeskAssignments", fields: [frontdeskUserId], references: [id], onDelete: Cascade)
  officer         OfficerProfile? @relation(fields: [officerId], references: [id], onDelete: Cascade)

  @@unique([frontdeskUserId, officerId])
  @@map("frontdesk_officers")
}

model ServiceCategory {
  id                      String                  @id @default(uuid())
  name                    String                  @unique
  description             String?
  isActive                Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  color                   String?
  applications            Application[]
  newCategoryChanges      ServiceCategoryChange[] @relation("NewCategory")
  previousCategoryChanges ServiceCategoryChange[] @relation("PreviousCategory")

  @@map("service_categories")
}

model Section {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  officers        OfficerProfile[]
  samadhanTickets SamadhanTicket[] @relation("SamadhanTicketSection")
  samadhanServices SamadhanService[] @relation("SectionServices")

  @@map("sections")
}

// SAMADHAN Services - Services offered by each section
model SamadhanService {
  id          String   @id @default(uuid())
  name        String
  description String?
  sectionId   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  section     Section  @relation("SectionServices", fields: [sectionId], references: [id], onDelete: Cascade)
  categories  SamadhanServiceCategory[] @relation("ServiceCategories")
  
  @@unique([name, sectionId])
  @@map("samadhan_services")
}

// SAMADHAN Service Categories - Categories under each service (Section -> Service -> Service Category)
model SamadhanServiceCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  serviceId   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  service     SamadhanService @relation("ServiceCategories", fields: [serviceId], references: [id], onDelete: Cascade)
  
  @@unique([name, serviceId])
  @@map("samadhan_service_categories")
}

model Department {
  id           String        @id @default(uuid())
  name         String        @unique
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]

  @@map("departments")
}

model Application {
  id                     String                     @id @default(uuid())
  rrNumber               String?                    @unique
  serviceCategoryId      String
  status                 ApplicationStatus          @default(DRAFT)
  currentHolderId        String?
  submittedAt            DateTime?
  validatedAt            DateTime?
  completedAt            DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  citizenAddress         String
  citizenEmail           String?
  citizenGender          String?
  citizenName            String
  citizenPhone           String
  citizenAlternateNumber String?
  subject                String                     @default("Application Subject")
  departmentId           String?
  dispatchedAt           DateTime?
  dispatchedById         String?
  isDispatched           Boolean                    @default(false)
  applicationSource      ApplicationSource          @default(PUBLIC)
  auditLogs              ApplicationAuditLog[]
  validation             ApplicationValidation?
  workflow               ApplicationWorkflow[]
  currentHolder          User?                      @relation("CurrentHolder", fields: [currentHolderId], references: [id])
  department             Department?                @relation(fields: [departmentId], references: [id])
  dispatchedBy           User?                      @relation("DispatchedBy", fields: [dispatchedById], references: [id])
  serviceCategory        ServiceCategory            @relation(fields: [serviceCategoryId], references: [id])
  documentRequests       DocumentRequest[]
  documents              Document[]
  frontdeskForwardings   FrontdeskForwarding[]
  notifications          Notification[]
  officerAssignments     OfficerAssignment[]
  officerForwardings     OfficerForwardingHistory[]
  serviceCategoryChanges ServiceCategoryChange[]

  @@map("applications")
}

model ApplicationWorkflow {
  id            String             @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String
  comments      String?
  createdAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id])
  changedBy     User               @relation("ChangedBy", fields: [changedById], references: [id])

  @@map("application_workflow")
}

model ApplicationValidation {
  id                    String      @id @default(uuid())
  applicationId         String      @unique
  validatedById         String
  rrNumber              String
  isDocumentsComplete   Boolean     @default(false)
  isEligibilityVerified Boolean     @default(false)
  validationNotes       String?
  createdAt             DateTime    @default(now())
  application           Application @relation(fields: [applicationId], references: [id])
  validatedBy           User        @relation("ValidatedBy", fields: [validatedById], references: [id])

  @@map("application_validations")
}

model ServiceCategoryChange {
  id                 String           @id @default(uuid())
  applicationId      String
  previousCategoryId String?
  newCategoryId      String
  changedById        String
  reason             String?
  createdAt          DateTime         @default(now())
  application        Application      @relation(fields: [applicationId], references: [id])
  changedBy          User             @relation("CategoryChangedBy", fields: [changedById], references: [id])
  newCategory        ServiceCategory  @relation("NewCategory", fields: [newCategoryId], references: [id])
  previousCategory   ServiceCategory? @relation("PreviousCategory", fields: [previousCategoryId], references: [id])

  @@map("service_category_changes")
}

model OfficerAssignment {
  id                     String      @id @default(uuid())
  applicationId          String
  assignedById           String
  assignedToId           String
  expectedCompletionDate DateTime?
  priority               Int         @default(1) // Always HIGH priority
  instructions           String?
  createdAt              DateTime    @default(now())
  application            Application @relation(fields: [applicationId], references: [id])
  assignedBy             User        @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedTo             User        @relation("AssignedTo", fields: [assignedToId], references: [id])

  @@map("officer_assignments")
}

model Document {
  id                String       @id @default(uuid())
  applicationId     String
  documentType      DocumentType
  fileName          String
  filePath          String
  fileSize          Int
  uploadedById      String
  isVerified        Boolean      @default(false)
  verifiedById      String?
  verificationNotes String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  application       Application  @relation(fields: [applicationId], references: [id])
  uploadedBy        User         @relation("UploadedBy", fields: [uploadedById], references: [id])
  verifiedBy        User?        @relation("VerifiedBy", fields: [verifiedById], references: [id])

  @@map("documents")
}

model DocumentRequest {
  id            String       @id @default(uuid())
  applicationId String
  requestedById String
  documentType  DocumentType
  reason        String?
  dueDate       DateTime?
  isCompleted   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  application   Application  @relation(fields: [applicationId], references: [id])
  requestedBy   User         @relation("RequestedBy", fields: [requestedById], references: [id])

  @@map("document_requests")
}

model Notification {
  id               String           @id @default(uuid())
  userId           String
  notificationType NotificationType
  applicationId    String?
  title            String
  message          String
  isRead           Boolean          @default(false)
  readAt           DateTime?
  createdAt        DateTime         @default(now())
  application      Application?     @relation(fields: [applicationId], references: [id])
  user             User             @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model ApplicationAuditLog {
  id            String      @id @default(uuid())
  applicationId String
  action        String
  performedById String
  oldValues     Json?
  newValues     Json?
  ipAddress     String?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id])
  performedBy   User        @relation("PerformedBy", fields: [performedById], references: [id])

  @@map("application_audit_logs")
}

model DailyReport {
  id                String   @id @default(uuid())
  reportDate        DateTime @db.Date
  totalApplications Int      @default(0)
  pendingValidation Int      @default(0)
  inProgress        Int      @default(0)
  completed         Int      @default(0)
  avgProcessingTime Int?
  createdAt         DateTime @default(now())

  @@map("daily_reports")
}

model SystemSetting {
  id           String   @id @default(uuid())
  settingKey   String   @unique
  settingValue String
  description  String?
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("system_settings")
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  token      String   @unique
  expires    DateTime
  type       String
  metadata   String?  // JSON string for storing additional secure data

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SmsOtp {
  id               String   @id @default(uuid())
  phone            String
  otp              String
  status           String   // SENT, FAILED, USED
  providerResponse String?  // JSON string for storing provider response
  type             String   @default("VERIFICATION") // VERIFICATION, LOGIN, PASSWORD_RESET
  attempts         Int      @default(0)
  isUsed           Boolean  @default(false)
  expires          DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("sms_otps")
}

model ApplicationTrackingOTP {
  id         String   @id @default(uuid())
  identifier String
  otp        String
  otpType    String
  sentTo     String
  isUsed     Boolean  @default(false)
  attempts   Int      @default(0)
  expires    DateTime
  createdAt  DateTime @default(now())

  @@map("application_tracking_otps")
}

model FrontdeskForwarding {
  id              String      @id @default(uuid())
  applicationId   String
  fromFrontdeskId String
  toFrontdeskId   String
  fromOfficerId   String
  toOfficerId     String
  instructions    String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  application     Application @relation(fields: [applicationId], references: [id])
  fromFrontdesk   User        @relation("ForwardedFrom", fields: [fromFrontdeskId], references: [id])
  toFrontdesk     User        @relation("ForwardedTo", fields: [toFrontdeskId], references: [id])

  @@map("frontdesk_forwardings")
}

model OfficerForwardingHistory {
  id            String      @id @default(uuid())
  applicationId String
  fromOfficerId String
  toOfficerId   String
  instructions  String?
  priority      Int         @default(1) // Always HIGH priority
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  completedAt   DateTime?
  forwardedAt   DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id])
  fromOfficer   User        @relation("OfficerForwardedFrom", fields: [fromOfficerId], references: [id])
  toOfficer     User        @relation("OfficerForwardedTo", fields: [toOfficerId], references: [id])

  @@map("officer_forwarding_history")
}

enum UserRole {
  CITIZEN
  FRONT_DESK
  DC
  ADC
  RO
  SDM
  DYDIR
  ADMIN
  SUPER_ADMIN
  ADC_GTK
  ADC_HQ
  SDM_GTK
  SDM_HQ
  AC
  DPO_DDMA
  DD_REV
  DD_ACQ
  US_ADM
  AO
  TO_DDMA
  AD_IT
  US_ELECTION
  OS_COI_RC
  OS_RC
  RI_LEGAL
  DISPATCH_HANDLER
}

enum ApplicationStatus {
  DRAFT
  PENDING
  VALIDATED
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum DocumentType {
  ID_PROOF
  ADDRESS_PROOF
  APPLICATION_FORM
  SUPPORTING_DOCUMENT
  PAYMENT_RECEIPT
}

enum NotificationType {
  APPLICATION_SUBMITTED
  STATUS_CHANGED
  DOCUMENT_REQUESTED
  PAYMENT_REQUIRED
}

enum ApplicationSource {
  PUBLIC
  GOVERNMENT
}

// ==================== SAMADHAN MODULE ====================
// Citizen Grievance, Feedback, and Suggestion Management System

enum SamadhanQueryType {
  FEEDBACK
  GRIEVANCE
  SUGGESTION
}

enum SamadhanPriority {
  LOW
  MEDIUM
  HIGH
}

enum SamadhanTicketStatus {
  DRAFT             // Ticket saved as draft by citizen
  QUEUED            // Ticket submitted and in queue for assignment
  UNSEEN
  SEEN
  ACKNOWLEDGED
  IN_PROGRESS
  PENDING_INFORMATION
  AWAITING_ESCALATION
  ESCALATED
  RESOLVED
  CLOSED
  CLOSED_NO_RESPONSE
  APPEALED          // Original ticket status when citizen files appeal - ticket forwarded to DC
  APPEAL_FILED      // Legacy status - keeping for backward compatibility
  OVERDUE
}

enum SamadhanSubmissionChannel {
  WEB_PORTAL
  WHATSAPP
  MOBILE_APP
}

enum SamadhanInfoRequestStatus {
  PENDING
  RESPONDED
  EXPIRED
}

// Main SAMADHAN Ticket model
model SamadhanTicket {
  id                    String                     @id @default(uuid())
  referenceId           String                     @unique // SAMADHAN-YYYY-MM-DD-XXXXX format
  queryType             SamadhanQueryType
  priority              SamadhanPriority           @default(MEDIUM)
  status                SamadhanTicketStatus       @default(DRAFT)
  
  // Citizen Information
  citizenId             String?                    // Nullable for anonymous submissions
  citizenName           String?                    // For anonymous or named submissions
  citizenEmail          String?
  citizenPhone          String?
  citizenPseudonym      String?                    // System-generated pseudonym
  isAnonymous           Boolean                    @default(false)
  isAnonymousToOfficer  Boolean                    @default(false)
  
  // Query Details - Updated for TypeForm flow
  sectionId             String
  subject               String?                    // Subject/title for the grievance/feedback
  serviceAvailed        String?                    // JSON array of service IDs
  description           String                     @db.Text
  visitedDC             Boolean?                   // Did citizen visit DC office
  visitDate             DateTime?                  // When did they visit
  
  // Assignment
  assignedOfficerId     String?
  escalatedToId         String?
  assignedById          String?                    // Who assigned the ticket from queue
  assignedAt            DateTime?                  // When was the ticket assigned
  
  // Submission Channel
  submissionChannel     SamadhanSubmissionChannel  @default(WEB_PORTAL)
  whatsappNumber        String?
  
  // SLA Management
  slaDeadline           DateTime?
  seenAt                DateTime?
  acknowledgedAt        DateTime?
  resolvedAt            DateTime?
  closedAt              DateTime?
  slaBreachedAt         DateTime?
  queuedAt              DateTime?                  // When ticket entered queue
  
  // Resolution
  resolutionMessage     String?                    @db.Text
  
  // Appeal
  isAppeal              Boolean                    @default(false)
  originalTicketId      String?
  
  // Draft functionality
  isDraft               Boolean                    @default(false)
  lastSavedAt           DateTime?
  
  // Timestamps
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  
  // Relations
  citizen               User?                      @relation("SamadhanCitizenTickets", fields: [citizenId], references: [id])
  section               Section                    @relation("SamadhanTicketSection", fields: [sectionId], references: [id])
  assignedOfficer       User?                      @relation("SamadhanAssignedOfficer", fields: [assignedOfficerId], references: [id])
  escalatedTo           User?                      @relation("SamadhanEscalatedTo", fields: [escalatedToId], references: [id])
  assignedBy            User?                      @relation("SamadhanAssignedBy", fields: [assignedById], references: [id])
  originalTicket        SamadhanTicket?            @relation("TicketAppeals", fields: [originalTicketId], references: [id])
  appeals               SamadhanTicket[]           @relation("TicketAppeals")
  attachments           SamadhanAttachment[]
  infoRequests          SamadhanInfoRequest[]
  statusHistory         SamadhanStatusHistory[]
  internalNotes         SamadhanInternalNote[]

  @@index([referenceId])
  @@index([citizenId])
  @@index([assignedOfficerId])
  @@index([status])
  @@index([sectionId])
  @@index([createdAt])
  @@map("samadhan_tickets")
}

// Attachments for SAMADHAN tickets
model SamadhanAttachment {
  id              String              @id @default(uuid())
  ticketId        String
  infoRequestId   String?             // If this is a response to an info request
  fileName        String
  originalName    String
  filePath        String
  fileType        String
  fileSize        Int
  uploadedById    String?             // Can be null for anonymous uploads
  uploadedByType  String              @default("CITIZEN") // CITIZEN or OFFICER
  createdAt       DateTime            @default(now())
  
  ticket          SamadhanTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  infoRequest     SamadhanInfoRequest? @relation(fields: [infoRequestId], references: [id])
  uploadedBy      User?               @relation("SamadhanAttachmentUploader", fields: [uploadedById], references: [id])

  @@map("samadhan_attachments")
}

// Information requests from officers to citizens
model SamadhanInfoRequest {
  id                  String                     @id @default(uuid())
  ticketId            String
  requestedById       String
  description         String                     @db.Text
  documentTypes       String?                    // JSON array of required document types
  deadline            DateTime
  status              SamadhanInfoRequestStatus  @default(PENDING)
  citizenResponse     String?                    @db.Text
  respondedAt         DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  
  ticket              SamadhanTicket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  requestedBy         User                       @relation("SamadhanInfoRequestedBy", fields: [requestedById], references: [id])
  attachments         SamadhanAttachment[]

  @@map("samadhan_info_requests")
}

// Status change history for audit trail
model SamadhanStatusHistory {
  id              String               @id @default(uuid())
  ticketId        String
  fromStatus      SamadhanTicketStatus?
  toStatus        SamadhanTicketStatus
  changedById     String?
  changeReason    String?
  isSystemGenerated Boolean            @default(false)
  createdAt       DateTime             @default(now())
  
  ticket          SamadhanTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy       User?                @relation("SamadhanStatusChangedBy", fields: [changedById], references: [id])

  @@map("samadhan_status_history")
}

// Internal notes for officer communication
model SamadhanInternalNote {
  id          String          @id @default(uuid())
  ticketId    String
  createdById String
  content     String          @db.Text
  createdAt   DateTime        @default(now())
  
  ticket      SamadhanTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy   User            @relation("SamadhanNoteCreator", fields: [createdById], references: [id])

  @@map("samadhan_internal_notes")
}

// SLA Configuration by query type and priority
model SamadhanSLAConfig {
  id          String             @id @default(uuid())
  queryType   SamadhanQueryType
  priority    SamadhanPriority
  slaHours    Int                // SLA duration in hours
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([queryType, priority])
  @@map("samadhan_sla_config")
}

// Daily sequence for reference ID generation
model SamadhanDailySequence {
  id          String   @id @default(uuid())
  date        DateTime @db.Date @unique
  lastSequence Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("samadhan_daily_sequence")
}
